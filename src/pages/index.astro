---
import PageLayout from '../layouts/PageLayout.astro';

const portraits = [
  {
    src: '/images/about/portrait-01.webp',
    alt: 'Black-and-white placeholder portrait in window light.',
    caption: 'In the quiet',
    number: '01',
  },
  {
    src: '/images/about/portrait-02.webp',
    alt: 'Black-and-white placeholder of a solitary figure by the sea.',
    caption: 'Elsewhere',
    number: '02',
  },
  {
    src: '/images/about/portrait-03.webp',
    alt: 'Black-and-white placeholder portrait in deep shadow.',
    caption: 'After hours',
    number: '03',
  },
];
---

<PageLayout
  title="About"
  description="Raul Sheth, a recent Computer Science and Philosophy graduate of Christ Church, University of Oxford, writing about AI Safety and philosophy."
  variant="about"
>
  <div class="about-spread">
    <section class="about-copy" aria-labelledby="about-greeting">
      <div class="about-kicker"><span>01 / About</span><span></span></div>
      <h1 id="about-greeting" class="about-greeting">Hi, I'm Raul!</h1>
      <div class="about-bio">
        <p class="about-bio__entry about-bio__entry--lead">
          <span class="about-bio__text">
            I have recently graduated from <strong>Christ Church, University of Oxford</strong> from
            <strong>Computer Science and Philosophy</strong>.
          </span>
        </p>
        <p class="about-bio__entry about-bio__entry--indented">
          <span class="about-bio__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
              <path d="M5 3v9a4 4 0 0 0 4 4h10m-4-4 4 4-4 4"></path>
            </svg>
          </span>
          <span class="about-bio__text">
            This is a little personal page where I talk about various AI Safety related topics that
            interest me!
          </span>
        </p>
        <p class="about-bio__entry about-bio__entry--indented">
          <span class="about-bio__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
              <path d="M5 3v9a4 4 0 0 0 4 4h10m-4-4 4 4-4 4"></path>
            </svg>
          </span>
          <span class="about-bio__text">
            Occasionally, I also plan to write the odd book review and summary, both for AI Safety
            and general philosophy.
          </span>
        </p>
      </div>
      <p class="about-signoff">Enjoy your Stay :)</p>
      <nav class="about-chapters" aria-label="Explore my writing">
        <a href="/blog"
          ><span class="about-chapters__number">02</span><span>Blog</span><svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"><path d="M5 19 19 5M5 5h14v14"></path></svg
          ></a
        >
        <a href="/literature-review"
          ><span class="about-chapters__number">03</span><span>Literature Review</span><svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"><path d="M5 19 19 5M5 5h14v14"></path></svg
          ></a
        >
      </nav>
    </section>
    <aside class="about-portraits" aria-label="Three portrait studies">
      <div class="about-portraits__label"><span>This is me!</span><span>01 — 03</span></div>
      <div class="portrait-grid">
        {
          portraits.map((portrait, index) => (
            <figure class:list={['portrait', `portrait--${index + 1}`]}>
              <img
                src={portrait.src}
                alt={portrait.alt}
                width="512"
                height="1024"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
              <figcaption>
                <>
                  <span>
                    {portrait.number} / {portrait.caption}
                  </span>
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    width="12"
                    height="12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="M5 19 19 5M5 5h14v14" />
                  </svg>
                </>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="about-portraits__footnote"></p>
    </aside>
  </div>
</PageLayout>
