---
import PageLayout from '../layouts/PageLayout.astro';

const portraits = [
  {
    src: '/images/about/portrait-01.webp',
    alt: 'Black-and-white placeholder portrait in window light.',
    caption: 'In the quiet',
    number: '01',
  },
  {
    src: '/images/about/portrait-02.webp',
    alt: 'Black-and-white placeholder of a solitary figure by the sea.',
    caption: 'Elsewhere',
    number: '02',
  },
  {
    src: '/images/about/portrait-03.webp',
    alt: 'Black-and-white placeholder portrait in deep shadow.',
    caption: 'After hours',
    number: '03',
  },
];
---

<PageLayout
  title="About"
  description="Raul Sheth. Writing, reading, and thoughts still taking shape."
  variant="about"
>
  <div class="about-spread">
    <section class="about-copy" aria-labelledby="about-name">
      <div class="about-kicker"><span>01 / About</span><span>A personal journal</span></div>
      <h1 id="about-name" class="about-name">Raul<br /><em>Sheth.</em></h1>
      <p class="about-lede">Reading between the lines.<br />Writing in the margins.</p>
      <div class="about-note">
        <span class="about-note__mark" aria-hidden="true">*</span>
        <div>
          <p>I’m Raul. Welcome to my corner of the internet.</p>
          <p>
            A home for what I’m thinking about, what I’m reading, and the ideas that stay with me.
          </p>
        </div>
      </div>
      <nav class="about-chapters" aria-label="Explore my writing">
        <a href="/blog"
          ><span class="about-chapters__number">02</span><span
            >Blog <em>— notes & thoughts</em></span
          ><svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"><path d="M5 19 19 5M5 5h14v14"></path></svg
          ></a
        >
        <a href="/literature-review"
          ><span class="about-chapters__number">03</span><span>Literature <em>Review</em></span><svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"><path d="M5 19 19 5M5 5h14v14"></path></svg
          ></a
        >
      </nav>
      <p class="about-colophon">An ongoing collection. <em>Always a work in progress.</em></p>
    </section>
    <aside class="about-portraits" aria-label="Three portrait studies">
      <div class="about-portraits__label"><span>A few frames</span><span>01 — 03</span></div>
      <div class="portrait-grid">
        {
          portraits.map((portrait, index) => (
            <figure class:list={['portrait', `portrait--${index + 1}`]}>
              <img
                src={portrait.src}
                alt={portrait.alt}
                width="512"
                height="1024"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
              <figcaption>
                <>
                  <span>
                    {portrait.number} / {portrait.caption}
                  </span>
                  <span aria-hidden="true">↗</span>
                </>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="about-portraits__footnote">The moments in between.</p>
    </aside>
  </div>
</PageLayout>
