      <h2>
        Blog <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"><path d="M5 19 19 5M5 5h14v14"></path></svg>
      </h2>
      <p>Thoughts, notes, and essays.</p>
    </a>
    <a href="/literature-review">
      <span class="section-links__number">03 / Reading</span>
      <h2>
        Literature <em>Review</em>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"><path d="M5 19 19 5M5 5h14v14"></path></svg>
