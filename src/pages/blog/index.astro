---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ArticleList from '../../components/ArticleList.astro';

const entries = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date || a.id.localeCompare(b.id),
);
---

<PageLayout title="Blog" eyebrow="02 / Writing" description="Thoughts, notes, and essays.">
  <ArticleList entries={entries} basePath="/blog" emptyMessage="New writing will appear here." />
</PageLayout>
