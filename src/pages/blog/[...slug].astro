---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<'blog'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(
  entry.data.date,
);
---

<PageLayout title={entry.data.title} description={entry.data.description} eyebrow="Blog">
  <article>
    <time class="post-meta" datetime={entry.data.date.toISOString()}>{date}</time>
    <div class="prose"><Content /></div>
  </article>
  <p class="back-link"><a href="/blog">← Back to Blog</a></p>
</PageLayout>
