---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ArticleList from '../../components/ArticleList.astro';

const entries = (await getCollection('literatureReview', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date || a.id.localeCompare(b.id),
);
---

<PageLayout
  title="Literature Review"
  eyebrow="03 / Reading"
  description="Reflections and perspectives on the literature."
>
  <ArticleList
    entries={entries}
    basePath="/literature-review"
    emptyMessage="New literature reviews will appear here."
  />
</PageLayout>
