---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  heroImage?: string;
  pageTitle?: string;
  variant?: 'default' | 'about';
}

const { title, description, eyebrow, heroImage, pageTitle, variant = 'default' } = Astro.props;
const headTitle = pageTitle ?? `${title} — Raul Sheth`;
---

<BaseLayout title={headTitle} description={description} image={heroImage}>
  <div class="page">
    <header class="page-nav">
      <a class="page-nav__brand" href="/">Raul <span>Sheth</span></a>
      <Navigation label="Primary" />
    </header>

    <main class:list={['page-main', { 'page-main--about': variant === 'about' }]}>
      {
        heroImage && (
          <div class="page-hero">
            <img src={heroImage} alt="" />
          </div>
        )
      }

      {
        variant !== 'about' && (
          <section class="page-head">
            {eyebrow && <div class="page-eyebrow">{eyebrow}</div>}
            <h1 class="page-title">{title}</h1>
            {description && <p class="page-deck">{description}</p>}
          </section>
        )
      }

      <div class="page-body">
        <slot />
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
